@article{Hughes:1998sf,
	abstract = {Sunspots are caused by the eruption of magnetic flux tubes through the solar photosphere: current theories of the internal magnetic field of the Sun suggest that such tubes must rise relatively unscathed from the base of the convection zone. In order to understand how the structure of the magnetic field within a buoyant flux tube affects its stability as it rises, we have considered the quasi-two-dimensional rise of isolated magnetic flux tubes through an adiabatically stratified atmosphere. The magnetic field is initially helical; we have investigated a range of initial field configurations, varying the distribution and strength of the twist of the field.},
	adsnote = {Provided by the SAO/NASA Astrophysics Data System},
