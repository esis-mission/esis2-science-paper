	journal = {\apjl},
	keywords = {Sun: Flares, Sun: Particle Emission, Sun: X-Rays, Gamma Rays},
	month = mar,
	pages = {L125-L128},
	title = {{Coronal Jet Observed by Hinode as the Source of a ^{3}He-rich Solar Energetic Particle Event}},
