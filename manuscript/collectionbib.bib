@article{Evans:1972fk,
	abstract = {We compare microphotometer intensity traces perpendicular to dispersion in simultaneous spectrograms of good spatial resolution traced at various Deltalambda's in each of the lines. Cross correlations between the different traces show the following: (a) For each Deltalambda K there is a corresponding Deltalambda b 1at which the coefficient of correlation, r, is a maximum, usually > 0.8. (b) No such high correlations are found between H and Hbeta. (c) Comparison of traces in the continuum and at all observed Deltalambda's in K, H, b1, b2 show a range of Deltalambda's in each line over which r is very significantly negative, while Hbeta shows no such peculiarity.},
