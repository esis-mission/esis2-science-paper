	doi = {10.1086/527043},
	journal = {\apj},
	keywords = {Magnetohydrodynamics: MHD, Sun: Corona, Sun: Magnetic Fields},
	local-url = {file://localhost/Users/juanms/Documents/Articulos/527043.pdf},
	month = mar,
	pages = {885-898},
	title = {{Pulsed Dissipation of Spontaneous Current Sheets in the Solar Corona}},
	url = {http://adsabs.harvard.edu/abs/2008ApJ...675..885P},
	volume = 675,
	year = 2008,
	bdsk-file-1 = {},
