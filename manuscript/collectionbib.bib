	keywords = {SOLAR ACTIVITY, SOLAR CORONA, SOLAR X-RAYS, X RAY ASTRONOMY, ASTRONOMICAL MODELS, CONVECTIVE FLOW, HYDROSTATIC PRESSURE, PARAMETERIZATION, PLASMA CONTROL, SKYLAB PROGRAM, STELLAR MAGNETIC FIELDS},
