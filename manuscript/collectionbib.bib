@article{Leenaarts:2005yq,
	abstract = {We compare high-quality image sequences from the Dutch Open Telescope (DOT) with synthetic image sequences obtained from 3D radiation-hydrodynamics simulations of the solar granulation. In particular, we study the subsonic brightness pattern observed in the wings of Ca II HK. The simulations reproduce the observed intensity contrast, time scales, and Fourier behaviour rather well. Most differences can be attributed to the resolution difference between the observations and the simulation and the small geometrical extent of the simulation. We conclude that magnetic fields play no major role in the formation of reversed granulation.},
