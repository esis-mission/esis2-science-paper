	journal = {The Astrophysical Journal},
	local-url = {file://localhost/Users/juanms/Documents/Articulos/529417.pdf},
	number = {1},
	pages = {699-703},
	title = {Magnetic Interaction: A Transequatorial Jet and Interconnecting Loops},
	url = {http://www.journals.uchicago.edu/doi/abs/10.1086/529417},
	volume = {677},
	year = {2008},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://www.journals.uchicago.edu/doi/abs/10.1086/529417},
